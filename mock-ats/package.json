{
  "name": "mock-ats",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Mock ATS API (Greenhouse/Eightfold-shaped) + candidate simulator agent, seeded with synthetic Faker data. Standalone service — not wired into the deployed frontend demo.",
  "scripts": {
    "generate:candidates": "tsx src/fixtures/generateCandidates.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "simulate:lifecycle": "tsx simulator/runLifecycle.ts",
    "simulate:watch": "tsx simulator/watch.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^9.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
