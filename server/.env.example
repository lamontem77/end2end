PORT=3001

# ─── Frontend origin (for CORS) ────────────────────────────────────────────────
# Dev: http://localhost:5173 | Production: https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# ─── Breezy HR ────────────────────────────────────────────────────────────────
# Your Breezy HR account credentials. The server signs in on startup and
# syncs candidates every 15 minutes.
BREEZY_EMAIL=
BREEZY_PASSWORD=
# Optional: if your account has multiple companies, set the company ID here.
# Leave blank to use the first company returned by the API.
BREEZY_COMPANY_ID=

# Optional: JSON mapping of Breezy stage names → our stage names.
# Only needed if your Breezy stages don't match the defaults.
# Example: {"Technical Interview": "Round N Scheduling", "Offer": "Offer Prep"}
BREEZY_STAGE_MAP=

# ─── Google (Gmail + Calendar) ────────────────────────────────────────────────
# 1. Go to console.cloud.google.com → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add http://localhost:3001/api/google/oauth/callback as an authorized redirect URI
# 4. Enable: Gmail API + Google Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/oauth/callback

# ─── Slack (optional, existing integration) ───────────────────────────────────
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...
SLACK_BOT_USER_ID=
